# Copy to .env for local development. Never commit real values.
# In deployment, set these in the host's secret store, not in files.

PORT=8787
# Exact origin the browser app is served from (used for CSRF checks and sign-in links).
APP_ORIGIN=http://localhost:5173

# Private-beta allowlist: comma-separated emails that may sign in.
ALLOWLIST=you@example.com

# Sign-in email via Resend (SEC-001). Unset: development prints links to the console; production refuses sign-in.
# MAIL_FROM must use a domain verified in Resend (SPF + DKIM), e.g. "Writedown <signin@yourdomain.com>".
RESEND_API_KEY=
MAIL_FROM=

# SQLite file for sessions, sign-in tokens and usage counters (server-side only; no documents).
DATABASE_PATH=writedown-server.db

# AI provider: "fake" (default, no network, free) or "anthropic".
AI_PROVIDER=fake
# Server-side only. Required when AI_PROVIDER=anthropic. Never exposed to the browser.
ANTHROPIC_API_KEY=
# Model per task (defaults shown).
MODEL_PROOFREAD=claude-haiku-5-5
MODEL_COMPOSE=claude-sonnet-5-5

# Limits (SEC-002): requests per user per UTC day, and total provider spend per UTC month.
DAILY_REQUESTS_PER_USER=100
MONTHLY_BUDGET_USD=10
